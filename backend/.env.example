CINCHPOS_AUTH_REQUIRED=true
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_SECRET_KEY=sk_test_or_live_value
CINCHPOS_OFFLINE_SESSION_HOURS=24

# CinchPOS account OTP email.
# GoDaddy Microsoft 365 usually uses smtp.office365.com / 587 / starttls.
# GoDaddy Professional Email powered by Titan usually uses smtpout.secureserver.net / 465 / ssl.
CINCHPOS_EMAIL_FROM=support@cinchpos.in
CINCHPOS_SMTP_HOST=smtp.office365.com
CINCHPOS_SMTP_PORT=587
CINCHPOS_SMTP_SECURITY=starttls
CINCHPOS_SMTP_USERNAME=support@cinchpos.in
CINCHPOS_SMTP_PASSWORD=replace_with_mailbox_or_app_password
CINCHPOS_OTP_EXPIRY_MINUTES=10
CINCHPOS_OTP_RESEND_SECONDS=60

# Optional phone OTP provider webhook. Leave empty until an SMS provider is connected.
CINCHPOS_SMS_WEBHOOK_URL=
